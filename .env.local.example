# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API) and your deployed URL. See docs/SETUP.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-side only, never exposed to the browser. Only used by
# scripts/seed.mjs and the admin "invite employee" server action.
SUPABASE_SERVICE_ROLE_KEY=

# The URL this app is deployed at (no trailing slash). Used to build
# email-confirmation redirect links. For local development, keep the
# localhost value below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
