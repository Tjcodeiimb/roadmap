{
  "track": {
    "id": "restructuring",
    "name": "restructuring",
    "label": "Distressed Debt & Restructuring",
    "tier": "intermediate",
    "domain": "finance",
    "estimated_hours": 60,
    "effort_per_week": "4-6 hrs",
    "icon_key": "finance",
    "published": true,
    "summary": "The technical core of restructuring and turnaround advisory — 13-week cash flow modeling, distressed valuation, the Chapter 11 process, and how to actually break into firms like Alvarez & Marsal and FTI Consulting."
  },
  "phases": [
    {
      "id": "rx-p1",
      "track_id": "restructuring",
      "order_index": 1,
      "title": "Foundations of Corporate Distress & the Restructuring Industry",
      "description": "Understand why companies actually fail, map the firms and roles that make up the restructuring industry, and learn the real, documented paths students use to break in.",
      "estimated_weeks": 2,
      "color": null
    },
    {
      "id": "rx-p2",
      "track_id": "restructuring",
      "order_index": 2,
      "title": "The Legal & Process Framework",
      "description": "Learn the mechanics of Chapter 11, Chapter 7, and out-of-court workouts — DIP financing, creditor committees, claims administration, and how priority of claims determines who gets paid.",
      "estimated_weeks": 2,
      "color": null
    },
    {
      "id": "rx-p3",
      "track_id": "restructuring",
      "order_index": 3,
      "title": "13-Week Cash Flow Modeling",
      "description": "Master the single technical skill A&M and FTI both name explicitly in recruiting — building, stress-testing, and presenting a 13-week cash flow model that lenders and creditors actually trust.",
      "estimated_weeks": 3,
      "color": null
    },
    {
      "id": "rx-p4",
      "track_id": "restructuring",
      "order_index": 4,
      "title": "Distressed Valuation & Credit Analysis",
      "description": "Value a distressed company under liquidation and going-concern scenarios, map the capital structure to find the fulcrum security, and build a recovery waterfall.",
      "estimated_weeks": 2,
      "color": null
    },
    {
      "id": "rx-p5",
      "track_id": "restructuring",
      "order_index": 5,
      "title": "Turnaround & Operational Restructuring",
      "description": "Diagnose the operating business behind the balance sheet — build an EBITDA bridge, structure a long-term business plan, and study how real companies turned around or didn't.",
      "estimated_weeks": 2,
      "color": null
    },
    {
      "id": "rx-p6",
      "track_id": "restructuring",
      "order_index": 6,
      "title": "Breaking In & Client-Facing Craft",
      "description": "Prepare for the unusually technical restructuring interview, position a non-traditional background convincingly, and understand where CIRA, CTP, and CFA fit in a restructuring career.",
      "estimated_weeks": 2,
      "color": null
    }
  ],
  "topics": [
    {
      "id": "rx-p1-t1",
      "phase_id": "rx-p1",
      "order_index": 1,
      "title": "Why Companies Fail — Liquidity, Solvency & the Distress Cycle",
      "description": "Distinguish a liquidity problem from a solvency problem, learn the early warning signs of financial distress, and understand the cycle that pulls a company from underperformance toward restructuring.",
      "estimated_time": "1.5 hours",
      "status": "todo"
    },
    {
      "id": "rx-p1-t2",
      "phase_id": "rx-p1",
      "order_index": 2,
      "title": "The Restructuring Industry Landscape — Consulting Firms, RX Banks & Law Firms",
      "description": "Map the players — turnaround consultancies like A&M and FTI, restructuring investment banks like PJT and Houlihan Lokey, and the law firms that run the courtroom side of a case.",
      "estimated_time": "1.5 hours",
      "status": "todo"
    },
    {
      "id": "rx-p1-t3",
      "phase_id": "rx-p1",
      "order_index": 3,
      "title": "Breaking In — Case Competitions, TMA, and the Audit-to-Restructuring Pipeline",
      "description": "Learn the real, recurring paths into the industry: the Big 4 audit/valuation/FDD-to-restructuring pipeline, TMA and TMA NextGen as a genuine student differentiator, and named case competitions that award real interviews.",
      "estimated_time": "2 hours",
      "status": "todo"
    },
    {
      "id": "rx-p2-t1",
      "phase_id": "rx-p2",
      "order_index": 1,
      "title": "Chapter 11 vs. Chapter 7 vs. Out-of-Court Workouts",
      "description": "Compare reorganization under Chapter 11, liquidation under Chapter 7, and negotiated out-of-court workouts — and understand why a company and its advisors choose one path over another.",
      "estimated_time": "1.5 hours",
      "status": "todo"
    },
    {
      "id": "rx-p2-t2",
      "phase_id": "rx-p2",
      "order_index": 2,
      "title": "DIP Financing, Creditor Committees & Claims Administration",
      "description": "Learn how debtor-in-possession financing keeps a bankrupt company running, how the official creditors' committee operates, and how proofs of claim and bar dates administer who gets to be paid.",
      "estimated_time": "2 hours",
      "status": "todo"
    },
    {
      "id": "rx-p2-t3",
      "phase_id": "rx-p2",
      "order_index": 3,
      "title": "Absolute Priority, Cramdown & a Brief Look at UK Administration/CVA",
      "description": "Understand the absolute priority rule and how a plan gets 'crammed down' over an objecting class, then contrast the US process with UK administration and Company Voluntary Arrangements.",
      "estimated_time": "1.5 hours",
      "status": "todo"
    },
    {
      "id": "rx-p3-t1",
      "phase_id": "rx-p3",
      "order_index": 1,
      "title": "Building a 13-Week Cash Flow Model From Scratch",
      "description": "Build a direct-method, weekly cash flow model from receipts and disbursements — the exact tool A&M and FTI use as the entry point to almost every restructuring engagement.",
      "estimated_time": "3 hours",
      "status": "todo"
    },
    {
      "id": "rx-p3-t2",
      "phase_id": "rx-p3",
      "order_index": 2,
      "title": "Minimum Cash, Liquidity Bridges & Variance Analysis",
      "description": "Set a defensible minimum cash threshold, build a liquidity bridge that ties covenant headroom to the forecast, and run the weekly actual-vs-forecast variance process that keeps the model credible.",
      "estimated_time": "2 hours",
      "status": "todo"
    },
    {
      "id": "rx-p3-t3",
      "phase_id": "rx-p3",
      "order_index": 3,
      "title": "Stress-Testing and Presenting a 13-Week Cash Flow to Lenders",
      "description": "Build base, downside, and stress scenarios into the model, then present it to a skeptical lender group who will challenge every assumption behind it.",
      "estimated_time": "2 hours",
      "status": "todo"
    },
    {
      "id": "rx-p4-t1",
      "phase_id": "rx-p4",
      "order_index": 1,
      "title": "Liquidation Value vs. Going-Concern Value",
      "description": "Learn the liquidation analysis that sets the 'floor' recovery for creditors, and understand when a business is worth more sold whole and operating than broken apart.",
      "estimated_time": "1.5 hours",
      "status": "todo"
    },
    {
      "id": "rx-p4-t2",
      "phase_id": "rx-p4",
      "order_index": 2,
      "title": "Capital Structure, Debt Tranches & the Fulcrum Security",
      "description": "Map a distressed company's capital stack from senior secured debt down to equity, and identify the fulcrum security — the tranche where enterprise value runs out and control converts to equity.",
      "estimated_time": "2 hours",
      "status": "todo"
    },
    {
      "id": "rx-p4-t3",
      "phase_id": "rx-p4",
      "order_index": 3,
      "title": "Recovery Analysis & the Distribution Waterfall",
      "description": "Build a recovery waterfall that ranks every class of claim by priority and pays them out until enterprise value is exhausted — the core output of any distressed valuation exercise.",
      "estimated_time": "2 hours",
      "status": "todo"
    },
    {
      "id": "rx-p5-t1",
      "phase_id": "rx-p5",
      "order_index": 1,
      "title": "Diagnosing the Business — Cost Structure & EBITDA Bridge Analysis",
      "description": "Break a company's cost base down into its real drivers and build an EBITDA bridge that explains, bar by bar, exactly what moved profitability between two periods.",
      "estimated_time": "2 hours",
      "status": "todo"
    },
    {
      "id": "rx-p5-t2",
      "phase_id": "rx-p5",
      "order_index": 2,
      "title": "Building the Long-Term Business Plan",
      "description": "Translate the diagnostic and the 13-week forecast into a multi-year business plan that underpins valuation, lender negotiations, and the plan of reorganization itself.",
      "estimated_time": "1.5 hours",
      "status": "todo"
    },
    {
      "id": "rx-p5-t3",
      "phase_id": "rx-p5",
      "order_index": 3,
      "title": "Case Studies in Real-World Corporate Turnarounds",
      "description": "Study well-documented turnarounds and liquidations — American Airlines, Hertz, and Toys 'R' Us among them — to see how the tools in this course played out in practice.",
      "estimated_time": "2 hours",
      "status": "todo"
    },
    {
      "id": "rx-p6-t1",
      "phase_id": "rx-p6",
      "order_index": 1,
      "title": "The Restructuring Interview — Technical Case Prep",
      "description": "Prepare for an interview process that is unusually technical and light on behavioral questions — candidates report Excel tests and simplified cash-flow model walkthroughs, not case-study frameworks.",
      "estimated_time": "2 hours",
      "status": "todo"
    },
    {
      "id": "rx-p6-t2",
      "phase_id": "rx-p6",
      "order_index": 2,
      "title": "Positioning Your Story — From Audit/Finance Background to Restructuring",
      "description": "Turn a Big 4 audit, FDD, or valuation background into a convincing restructuring narrative — what transfers directly, what you need to backfill, and how to frame the pivot.",
      "estimated_time": "1.5 hours",
      "status": "todo"
    },
    {
      "id": "rx-p6-t3",
      "phase_id": "rx-p6",
      "order_index": 3,
      "title": "Certifications & Career Pathway — CIRA, CTP, CFA",
      "description": "Understand CIRA, CTP, and the CFA charter as career-progression credentials you pursue once you're in the industry, not requirements to break in.",
      "estimated_time": "1 hour",
      "status": "todo"
    }
  ],
