{
  "track": {
    "id": "finance",
    "name": "finance",
    "label": "Finance"
  },
  "phases": [
    {
      "id": "fin-p1",
      "track_id": "finance",
      "order_index": 1,
      "title": "Foundations",
      "description": "Build accounting literacy — read a P&L, balance sheet, and cash flow statement, and trace how money moves through a business.",
      "estimated_weeks": "4-6",
      "color": null
    },
    {
      "id": "fin-p2",
      "track_id": "finance",
      "order_index": 2,
      "title": "Corporate Finance",
      "description": "Learn how firms fund themselves and choose investments — capital structure, WACC, capital budgeting, working capital.",
      "estimated_weeks": "4-6",
      "color": null
    },
    {
      "id": "fin-p3",
      "track_id": "finance",
      "order_index": 3,
      "title": "Markets & Instruments",
      "description": "Understand the instruments (equity, debt, derivatives) and the players — how sell-side and buy-side firms differ.",
      "estimated_weeks": "3-5",
      "color": null
    },
    {
      "id": "fin-p4",
      "track_id": "finance",
      "order_index": 4,
      "title": "Investment Banking",
      "description": "Walk the IB deal process — pitch books, comparable company analysis (comps), and DCF modeling.",
      "estimated_weeks": "5-7",
      "color": null
    },
    {
      "id": "fin-p5",
      "track_id": "finance",
      "order_index": 5,
      "title": "M&A",
      "description": "Learn how deals are structured and value is created or destroyed — synergies, due diligence, post-merger integration.",
      "estimated_weeks": "4-6",
      "color": null
    },
    {
      "id": "fin-p6",
      "track_id": "finance",
      "order_index": 6,
      "title": "Equity",
      "description": "Master the equity research process and valuation toolkit (DCF, comps, precedent transactions) plus portfolio construction basics.",
      "estimated_weeks": "4-6",
      "color": null
    },
    {
      "id": "fin-p7",
      "track_id": "finance",
      "order_index": 7,
      "title": "Applied",
      "description": "Apply it all to real filings and mock deals — read 10-Ks/10-Qs, practice deal exercises, prep for finance interviews.",
      "estimated_weeks": "4-6",
      "color": null
    },
    {
      "id": "fin-p8",
      "track_id": "finance",
      "order_index": 8,
      "title": "Advanced Financial Modeling",
      "description": "Go beyond reading statements — build a fully integrated 3-statement model from scratch, layer in acquisition debt with an LBO model, and analyze credit risk the way a lender does.",
      "estimated_weeks": "5-7",
      "color": null
    },
    {
      "id": "fin-p9",
      "track_id": "finance",
      "order_index": 9,
      "title": "Private Equity & Alternative Investments",
      "description": "Explore the buy-side beyond public markets — how private equity funds source and structure deals, how hedge funds generate returns across strategies, and how venture capital evaluates early-stage bets.",
      "estimated_weeks": "4-6",
      "color": null
    }
  ],
